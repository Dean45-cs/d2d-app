# ---------------------------------------------------------------------------
# D2D-App Konfiguration
# Datei nach .env.local kopieren und Werte anpassen.
# ---------------------------------------------------------------------------

# Geheimer Schluessel zum Signieren der Login-Sessions.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=bitte-aendern-langer-zufallsstring

# Pfad zur SQLite-Datenbank (Standard: ./data/d2d.db)
DATABASE_PATH=./data/d2d.db

# ---------------------------------------------------------------------------
# Ersteinrichtung
# ---------------------------------------------------------------------------
# Ist die Datenbank beim Serverstart noch leer, werden daraus Team und
# Teamleitung angelegt. Ein späterer Neustart ändert nichts mehr - das
# Passwort lässt sich danach nur noch in der App ändern.
SEED_TEAM=Door2Door Team
SEED_LEADER_NAME=Teamleitung
SEED_LEADER_EMAIL=
SEED_LEADER_PASSWORD=

# ---------------------------------------------------------------------------
# Push-Nachrichten (Abschluss eines abonnierten Kollegen)
# ---------------------------------------------------------------------------
# Normalfall: leer lassen. Die App erzeugt die Schluessel beim ersten Bedarf
# selbst und merkt sie sich in der Datenbank. Nur setzen, wenn die Schluessel
# unabhaengig von der Datenbank feststehen sollen (etwa bei einem Umzug) -
# ein Wechsel meldet alle Geraete ab, sie muessen Push neu einschalten.
#   Erzeugen z. B. mit:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt fuer die Push-Dienste von Apple, Google und Mozilla.
# Leer = mailto: mit der E-Mail der ersten Teamleitung.
VAPID_SUBJECT=

# Ziel-URL der Auftragserfassung des Partners (Abschluss-Button).
NEXT_PUBLIC_TARIFRECHNER_URL=https://portal-ep24.de/menues/tarifrechner/

# ---------------------------------------------------------------------------
# Karten
# ---------------------------------------------------------------------------
# Standard: OpenFreeMap (kostenlos, ohne Schluessel). Eigene Kartenstile:
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_STYLE_URL_DARK=

# ---------------------------------------------------------------------------
# Apple Karten (MapKit JS) - optional, uebernimmt sobald eingetragen
# ---------------------------------------------------------------------------
# Schluessel aus dem Apple-Developer-Konto (Keys -> MapKit JS). Der Server
# stellt damit selbst kurzlebige Tokens aus. Anleitung: README, "Apple Karten".
APPLE_MAPKIT_TEAM_ID=
APPLE_MAPKIT_KEY_ID=
# Inhalt der .p8-Datei; Zeilenumbrueche duerfen als \n geschrieben werden.
APPLE_MAPKIT_PRIVATE_KEY=
# Optional: Token nur fuer diese Adresse gueltig, z. B. https://d2d-app.fly.dev
APPLE_MAPKIT_ORIGIN=
# Alternativ ein fertiges Token aus dem Developer-Konto (statt der drei Werte oben)
APPLE_MAPKIT_TOKEN=
# Erzwingt eine Karte: "openfreemap", "apple" oder "osm" (leer = automatisch).
MAP_PROVIDER=

# ---------------------------------------------------------------------------
# Gebietseinteilung auf der Karte
# ---------------------------------------------------------------------------
# Kachel-Dienst fuer den OpenStreetMap-Rueckfall (ohne Apple-Schluessel).
# Fuer den Dauerbetrieb einen eigenen Dienst eintragen und dessen Bedingungen beachten.
NEXT_PUBLIC_MAP_TILE_URL=

# Overpass liefert die Strassen und Hausnummern innerhalb der gezeichneten
# Flaeche. Mehrere Adressen mit Komma trennen: ist die erste ausgelastet
# (Fehler 429), nimmt die App die naechste. Leer lassen = die drei unten.
# Fuer den taeglichen Einsatz lohnt eine eigene Instanz.
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter

# Nominatim uebersetzt die Ortssuche in Koordinaten und liefert PLZ und Ort.
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Die oeffentlichen Server verlangen einen aussagekraeftigen Absender mit
# Kontaktmoeglichkeit - bitte eintragen, sonst drohen Sperren.
GEO_USER_AGENT=d2d-app (kontakt@deinefirma.de)

# Laender, in denen die Ortssuche sucht.
GEO_COUNTRY_CODES=de,at,ch

# ---------------------------------------------------------------------------
# Energiekarte: optionale Tagesquelle
# ---------------------------------------------------------------------------
# Normalfall: keine. Die Teamleitung traegt die Grundversorger-Preise direkt
# auf der Energiekarte ein - einzeln vom Preisblatt oder als Tabelle.
#
# Wer eine Quelle hat (Export eines Tarifdatenanbieters, als CSV
# veroeffentlichte Google-Tabelle), kann sie zusaetzlich taeglich abrufen:
#   csv  = taeglicher Abruf einer CSV-Datei unter ENERGY_FEED_URL
#   json = taeglicher Abruf einer JSON-Datei/API unter ENERGY_FEED_URL
# Leer lassen = keine Tagesquelle.
ENERGY_FEED_MODE=
ENERGY_FEED_URL=
ENERGY_FEED_TOKEN=
# Name der Quelle, wie er in der App angezeigt wird
ENERGY_FEED_LABEL=

# Mit Tagesquelle holt die App die Preise von sich aus einmal taeglich. Auf 0
# setzen, wenn stattdessen ein eigener Cron-Dienst /api/energy/refresh aufruft.
ENERGY_AUTO_REFRESH=1

# Schluessel fuer einen externen Cron-Aufruf von /api/energy/refresh
ENERGY_REFRESH_TOKEN=bitte-aendern
